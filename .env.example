# Copy to .env and fill in. .env is gitignored.

# --- Gemini (required) ---
GEMINI_API_KEY=your-gemini-api-key
# Optional model overrides (defaults shown):
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-2

# --- User identity (single-user Streamlit; also the default API user) ---
SMARTCAT_USER_NAME=Your Name
SMARTCAT_USER_EMAIL=you@example.com

# --- Scalability layer (required once you run the FastAPI backend / Postgres / Redis) ---
# Matches docker-compose.yml. Start infra with: docker compose up -d
DATABASE_URL=postgresql+psycopg://smartcat:smartcat@localhost:5432/smartcat
REDIS_URL=redis://localhost:6379/0
